WORKSPACE_BUCKET="gs://workspace-bucket-wb-radiant-cabbage-3726"


profiles {
  gcb {
      process.executor = "google-batch"
      workDir = "$WORKSPACE_BUCKET/workflows/nextflow-scratch"

      google.location = "us-central1"
      google.project = "$GOOGLE_CLOUD_PROJECT"
      google.enableRequesterPaysBuckets = true
      google.batch.debug = true
      google.batch.serviceAccountEmail = "${PET_SA_EMAIL}"
      google.batch.network = "global/networks/network"
      google.batch.subnetwork = "regions/us-central1/subnetworks/subnetwork"
      google.batch.usePrivateAddress = true
      google.batch.copyImage = "gcr.io/google.com/cloudsdktool/cloud-sdk:alpine"
      google.batch.bootDiskSize = "50.GB"
  }

   spot {
        google.batch.spot = true
        google.batch.maxSpotAttempts = 3
        errorStrategy = { task.exitStatus == 50001 ? 'retry' : 'finish'}
        maxRetries = 3
   }
}


params {
  ticket = "BID-XXXX"
  ancestries = ["AFR"] //subset of ["AFR", "AMR", "EAS", "EUR", "SAS"]
  models = ["A"] //subset of ["A", "AX", "AY"]
  burden = false
  assoctype = params.burden == true ? "burden" : "FULL"



  outdir = "${WORKSPACE_BUCKET}/results/${params.ticket}"
  phenotypes_files = "${WORKSPACE_BUCKET}/phenotypes_split/*.tsv"
  phenotypes_binary_trait = true
  trait_type = params.phenotypes_binary_trait == true ? "cc" : "qtl"
  
  covariates_file = "gs://workspace-bucket-wb-radiant-cabbage-3726/covariates.tsv"
  ancestry_file = "gs://workspace-bucket-wb-radiant-cabbage-3726/ancestry.tsv"
  
  // array data
  // EUR
  plink_mac = 5 // filter variants with MAC < 5 per phenotype file
  plink_maf = 0.01 // filter variants with MAF < 0.01 per phenotype file
  genotypes_array_chunks = 10

  // Step-2 BGEN input. Specify exactly one at run time:
  //   --genotypes_bgen 'gs://bucket/path/*.bgen'
  //   --bgen_manifest manifest.tsv  (columns: bgen, id, chrom, start, end)
  // In burden mode a manifest is treated as a de-duplicated list of complete
  // BGENs; its chromosome ranges are intentionally ignored.

  genotypes_bgen = params.burden == true ? "gs://vwb-aou-datasets-controlled/v9/wgs/short_read/snpindel/exome/bgen/*.bgen"  : null
  bgen_manifest = params.burden == true ? null : "gs://workspace-bucket-wb-radiant-cabbage-3726/manifest.tsv"


  genotypes_bgen = null
  bgen_manifest = null
  sample_file = params.burden == true ? "gs://vwb-aou-datasets-controlled/v9/wgs/short_read/snpindel/exome/bgen/exome.chr1.sample" : \
                                        "gs://vwb-aou-datasets-controlled/v9/wgs/short_read/snpindel/acaf_threshold/bgen/acaf_threshold.chr1.sample"
  
  regenie_test        = 'additive'
  regenie_bsize_step1 = 1000
  regenie_bsize_step2 = 400
  regenie_firth       = false
  regenie_firth_approx = false

  // burden annotation
  regenie_gene_masks                    = "gs://workspace-bucket-wb-radiant-cabbage-3726/burden/masks.tsv"
  regenie_gene_setlist                  = "gs://workspace-bucket-wb-radiant-cabbage-3726/burden/set_list.tsv"
  regenie_gene_anno                     = "gs://workspace-bucket-wb-radiant-cabbage-3726/burden/annotation.tsv"

  regenie_gene_aaf     = "0.001,0.02"
}




process {
    withName: 'RegenieStep1.*' {
        cpus = 4
        memory = 16.GB
        scratch = true
        //machineType = 'n2-standard-4'
        //disk = '500GB'
    }

    withName: 'RegenieStep1_L1' {
        cpus = 8
        memory = 12.GB


    }

    withName: 'RegenieStep2.*' {
        cpus = 4
        memory = 8.GB
        scratch = true
        //machineType = 'n2-standard-2'
        //disk = '500GB'
    }

    withName: 'MergePerPhenotype' {
        cpus = 1
        memory = 2.GB
        scratch = true
        //machineType = 'n2-standard-2'
    }
}




// includeConfig 'conf/aou_burden.config'

process.container = "florianzink/nf-gwas-gcloud:v0.3"

